# Copy to .env.local and fill in. Never commit real values.

# Public base URL used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Resend (https://resend.com) — required for live quote-form delivery.
# If any of the three below is empty, the form reports that online
# submission is not yet enabled and does NOT show a success message.
RESEND_API_KEY=
# Inbox(es) that receive quote requests; comma-separate multiple addresses.
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Name <quotes@your-domain>".
QUOTE_FROM_EMAIL=
